#!/usr/bin/env python3
"""Compatibility launcher for the installed read-only ltp-cli list command.

ltp-cli 0.1.6 expects the task-list response under a JSON-encoded ``data``
field, while the current service returns ``jobs`` at the response root. This
launcher keeps the official ltp-cli command and show implementation, replacing
only list rendering with stable JSON for Research Ops ingestion.
"""

from __future__ import annotations

import json
import os
import sys
from typing import Any

from ltp_cli.src import client as official


def _mapping(value: Any) -> dict[str, Any]:
    if isinstance(value, str):
        value = json.loads(value)
    return value if isinstance(value, dict) else {}


def _list_tasks(args: Any) -> None:
    username = args.user or official.get_username()
    client = official.JobServiceClient(base_url=args.api_url)
    params: dict[str, Any] = {
        "username": username,
        "page_size": max(1, min(2_000, int(os.getenv("ROPS_LTP_MONITOR_MAX_JOBS", "100")))),
    }
    if args.cluster:
        params["cluster"] = args.cluster
    if args.refresh:
        params["refresh"] = "true"
    try:
        response = official.requests.get(
            client._get_url("/api/tasks"),
            params=params,
            timeout=float(os.getenv("ROPS_LTP_MONITOR_STATUS_PROBE_TIMEOUT_SECONDS", "20")),
        )
        response.raise_for_status()
        payload = _mapping(response.json())
        data = _mapping(payload.get("data")) or payload
        jobs = data.get("jobs")
        if not isinstance(jobs, list):
            raise ValueError("task-list response omitted jobs")
    except Exception as exc:
        print(f"获取任务列表失败: {type(exc).__name__}", file=sys.stderr)
        raise SystemExit(1) from exc
    print(json.dumps({"jobs": jobs}, ensure_ascii=False, separators=(",", ":")))


def main() -> None:
    official.list_tasks = _list_tasks
    official.main()


if __name__ == "__main__":
    main()
