{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "titles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "thread_id": { "type": "string" },
          "title": { "type": "string", "minLength": 1, "maxLength": 80 }
        },
        "required": ["thread_id", "title"],
        "additionalProperties": false
      }
    }
  },
  "required": ["titles"],
  "additionalProperties": false
}
