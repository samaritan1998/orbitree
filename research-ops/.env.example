ROPS_HOST=127.0.0.1
ROPS_PORT=8020
ROPS_DATA_DIR=./data
# Optional local-disk directory for the SQLite database and server logs. This
# keeps the Web control plane responsive when workspaces live on NFS/CFS.
# ROPS_RUNTIME_DIR=/workspace/research-ops-runtime
# Use an absolute, human-readable root in production, for example /workspace/Q3.
ROPS_WORKSPACE_ROOT=./data/research-workspaces
# Optional interactive shell. Requires tmux; no model or AI session is created.
# Single-user deployments require an unlock key from `rops terminal key`.
# Team workers authenticate through the account gateway and retain their UID.
ROPS_WEB_TERMINAL_ENABLED=false
# ROPS_WEB_TERMINAL_CWD=/absolute/path/to/workspace
ROPS_WEB_TERMINAL_SHELL=/bin/bash
ROPS_WEB_TERMINAL_TMUX=tmux
ROPS_CODEX_ENABLED=true
ROPS_CODEX_COMMAND=codex
ROPS_CODEX_BACKEND=cli
# Optional egress for Personal Codex login and execution only. Company API and
# the parent Web service do not receive these proxy settings.
# ROPS_CODEX_PERSONAL_HTTP_PROXY=http://proxy.example:8891
# ROPS_CODEX_PERSONAL_HTTPS_PROXY=http://proxy.example:8891
# ROPS_CODEX_PERSONAL_NO_PROXY=localhost,127.0.0.1,::1
# Set to pi (or ROPS_PI_ENABLED=true) to run the optional Pi RPC runtime.
# Codex remains the default and is unchanged by these settings.
# ROPS_CODEX_BACKEND=pi
ROPS_PI_ENABLED=false
ROPS_PI_COMMAND=pi
ROPS_PI_SESSION_DIR=~/.pi/agent/sessions
ROPS_PI_PROVIDER=openai-codex
ROPS_PI_MODEL=gpt-6-astra
ROPS_PI_THINKING=max
# Pi's model gateway requires the internal proxy on this host. These values
# are injected only into Pi subprocesses, never into Codex or training jobs.
# ROPS_PI_HTTP_PROXY=http://proxy.example.com:8891
# ROPS_PI_HTTPS_PROXY=http://proxy.example.com:8891
# ROPS_PI_NO_PROXY=localhost,127.0.0.1
ROPS_PI_EXTENSIONS_ENABLED=false
# ROPS_PI_TOOLS=read,grep,find,ls,bash,edit,write
# Claude Code uses the CLI's existing login. Orbitree stores only the
# Claude session ID and never copies ~/.claude credentials.
ROPS_CLAUDE_ENABLED=true
ROPS_CLAUDE_COMMAND=claude
ROPS_CLAUDE_ACCOUNT_LABEL=CLI account
ROPS_CLAUDE_HOME=~/.claude
ROPS_CLAUDE_MODEL=auto
ROPS_CLAUDE_EFFORT=high
ROPS_CLAUDE_PERMISSION_MODE=bypassPermissions
ROPS_CLAUDE_TURN_TIMEOUT_SECONDS=86400
ROPS_CLAUDE_EVENT_LINE_LIMIT_BYTES=8388608
# Unset to inherit the selected identity's native Codex configuration.
# ROPS_CODEX_APPROVAL_POLICY=on-request
# ROPS_CODEX_SANDBOX=workspace-write
# Allow independent Branches to run Web/Pi turns concurrently. Same-Branch
# turns remain single-writer; capacity failures retry with exponential backoff.
# 0 disables the Orbitree semaphore; set a positive value only when you
# explicitly want a deployment-level cap.
ROPS_CODEX_MAX_CONCURRENT_TURNS=0
ROPS_CODEX_CAPACITY_RETRY_ATTEMPTS=3
ROPS_CODEX_CAPACITY_RETRY_INITIAL_SECONDS=30
ROPS_CODEX_CAPACITY_RETRY_MAX_SECONDS=300
# Retry a dropped model stream once only when no Codex item has started. This
# avoids replaying a command or an external submission after an ambiguous error.
ROPS_CODEX_TRANSPORT_RETRY_ATTEMPTS=1
ROPS_CODEX_TRANSPORT_RETRY_INITIAL_SECONDS=5
ROPS_CODEX_TRANSPORT_RETRY_MAX_SECONDS=30
# Forking a long persisted thread can require compaction; keep its timeout separate.
ROPS_CODEX_FORK_TIMEOUT_SECONDS=120
# Maximum size of one Codex JSONL event. Large read-only tool results can exceed 64 KiB.
ROPS_CODEX_EVENT_LINE_LIMIT_BYTES=8388608
# Repair missing historical/display queries without scanning every turn each cycle.
ROPS_CODEX_PROMPT_BACKFILL_INTERVAL_SECONDS=30
# Discover local Codex TUI processes and recent resumable threads.
ROPS_CODEX_REGISTRY_ENABLED=true
ROPS_CODEX_REGISTRY_SCAN_INTERVAL_SECONDS=10
ROPS_CODEX_REGISTRY_MAX_SESSIONS=250
ROPS_CODEX_REGISTRY_LOOKBACK_DAYS=30
# Generate short names with the locally authenticated Codex CLI. Runs are ephemeral.
ROPS_CODEX_TITLE_GENERATION_ENABLED=false
ROPS_CODEX_TITLE_GENERATION_BATCH_SIZE=8
ROPS_CODEX_TITLE_GENERATION_TIMEOUT_SECONDS=180
# Optional AI-assisted skill extraction. Proposals require explicit acceptance before writing.
ROPS_SKILL_EXTRACTION_ENABLED=false
ROPS_SKILL_SOURCE_ROOT=./data/skills
ROPS_SKILL_INSTALL_ROOT=~/.codex/skills
ROPS_SKILL_EXTRACTION_TIMEOUT_SECONDS=300
ROPS_SKILL_EXTRACTION_MAX_TURNS=12
# Durable Goal worker. Long agent checkpoints renew their database lease at
# this interval so a slow turn cannot be dispatched twice.
ROPS_GOAL_LEASE_SECONDS=900
ROPS_GOAL_LEASE_HEARTBEAT_SECONDS=60
# Durable, opt-in per-Branch scheduled checks. The worker idles without a model;
# creating a schedule does not create a Goal or start a check immediately.
ROPS_SCHEDULED_CHECKS_ENABLED=true
ROPS_SCHEDULED_CHECK_TICK_SECONDS=15
# Optional nightly reflection. At local midnight, a separate ephemeral, read-only
# Codex run reviews the just-finished calendar day and stores its report in /memory.
ROPS_DAILY_REFLECTION_ENABLED=false
ROPS_DAILY_REFLECTION_TIMEZONE=Asia/Shanghai
ROPS_DAILY_REFLECTION_HOUR=0
ROPS_DAILY_REFLECTION_MINUTE=0
ROPS_DAILY_REFLECTION_POLL_INTERVAL_SECONDS=30
ROPS_DAILY_REFLECTION_TIMEOUT_SECONDS=900
ROPS_DAILY_REFLECTION_MAX_RECORDS=240
ROPS_DAILY_REFLECTION_MAX_PROMPT_CHARS=140000
ROPS_DAILY_REFLECTION_ITEM_CHARS=2400
ROPS_DAILY_REFLECTION_INFOFLOW_ENABLED=true
# Optional single-chat reminder after each persisted Codex turn. Keep the
# actual AppKey/AppSecret in deployment environment variables, not source.
ROPS_INFOFLOW_NOTIFICATIONS_ENABLED=false
# Send a durable single-chat alert when a Web conversation reaches Error.
# This has no effect unless ROPS_INFOFLOW_NOTIFICATIONS_ENABLED=true.
ROPS_INFOFLOW_ERROR_NOTIFICATIONS_ENABLED=true
ROPS_INFOFLOW_RECIPIENT=alice
# Browser-facing origin for notification links. Behind a login gateway, use
# the public HTTPS domain here but keep local CLI control on localhost.
# Deployment: https://research.example.com
ROPS_INFOFLOW_PUBLIC_BASE_URL=http://127.0.0.1:8020
ROPS_INFOFLOW_APP_KEY_ENV=INFOFLOW_APP_KEY
ROPS_INFOFLOW_APP_SECRET_ENV=INFOFLOW_APP_SECRET
# Optional secure file fallback. Supports INFOFLOW_APP_KEY/APP_SECRET and
# infoflow-message-group's INFOFLOW_AK/INFOFLOW_SK names; mode must be 0600.
# ROPS_INFOFLOW_CREDENTIALS_FILE=/root/.infoflow_config
# INFOFLOW_APP_KEY=
# INFOFLOW_APP_SECRET=

# Independent LTP task monitor. It discovers only the configured users' jobs,
# records status transitions, and can notify a Mavin/Infoflow group.
ROPS_LTP_MONITOR_ENABLED=false
ROPS_LTP_MONITOR_USERS='["alice"]'
ROPS_LTP_MONITOR_POLL_INTERVAL_SECONDS=30
ROPS_LTP_MONITOR_MAX_JOBS=100
# Use ltp-cli directly when its list command works. The bundled compatibility
# launcher only repairs the response-shape bug in ltp-cli 0.1.6.
ROPS_LTP_MONITOR_CLI=ltp-cli
# ROPS_LTP_MONITOR_CLI=/absolute/path/to/research-ops/scripts/ltp-cli-monitor
# ROPS_LTP_MONITOR_CLI_API_URL=https://<ltp-api-host>
ROPS_LTP_MONITOR_STATUS_PROBE_ENABLED=true
ROPS_LTP_MONITOR_STATUS_PROBE_CONCURRENCY=6
ROPS_LTP_MONITOR_NOTIFICATIONS_ENABLED=false
# ROPS_LTP_MONITOR_GROUP_ID=12345678
# ROPS_LTP_MONITOR_NOTIFY_STATES='["created","pending","running","failed"]'
# Managed Codex default. Set both values together when changing the model.
ROPS_CODEX_MODEL=gpt-6-astra
ROPS_CODEX_REASONING_EFFORT=max
# Optional provider ID from $CODEX_HOME/config.toml. Setting this explicitly also
# overrides the provider stored in older resumed Codex sessions.
# ROPS_CODEX_MODEL_PROVIDER=
# JSON list of user-config MCP servers to disable only for managed Web turns.
# ROPS_CODEX_DISABLED_MCP_SERVERS=["openaiDeveloperDocs"]
# ROPS_ACCESS_TOKEN=

# OpenReward/ORS is opt-in. These are names only; inject runtime values through
# the deployment secret/environment manager.
# ROPS_OPENREWARD_ENABLED=false
# ROPS_OPENREWARD_SESSION_TTL_SECONDS=900
# Optional; names the runtime variable used by X-API-Key/Bearer authentication.
# ROPS_OPENREWARD_API_KEY_ENV=OPENREWARD_SERVER_API_KEY
# ROPS_OPENREWARD_BACKEND_MODE=mock
# ROPS_OPENREWARD_BACKEND_CONFIG=./config/openreward-backends.example.yaml
# ROPS_OPENREWARD_TASK_CATALOG=./config/openreward-tasks.example.yaml
# Use ["miaoda"] to connect Miaoda first while SWE/PPT/ToolUse remain safe mocks.
# ROPS_OPENREWARD_REAL_DOMAINS=["miaoda","swe","ppt","tooluse"]
# ROPS_AGENTOS_DATAWHEEL_BASE_URL=
# ROPS_AGENTOS_TRAJECTORY_BASE_URL=
# ROPS_AGENTOS_TOKEN_ENV=DATAWHEEL_TOKEN
# ROPS_GOBLIN_ENABLED=false
# ROPS_GOBLIN_BASE_URL=
# ROPS_GOBLIN_TOKEN_ENV=GOBLIN_REWARD_API_TOKEN

# Miaoda canary runner references (values intentionally omitted).
# DATAWHEEL_API_BASE=
# DATAWHEEL_GENERATED_USER_ID=
# DATAWHEEL_TOKEN=
# AGENTOS_MODEL_API_KEY=
# MOPD_POLICY_MODEL_NAME=
# MOPD_POLICY_API_URL=
# GOBLIN_REWARD_API_TOKEN=
# GOBLIN_REWARD_RESULT_ROOT=

# Real SlideForge PPT runtime and Reward adapter. Keep values in the deployment
# secret manager; only environment-variable references belong in task config.
# ORS_PPT_POLICY_IMAGE=registry.example.com/acg-agi/ppt-rollout:0610-deps
# ORS_PPT_TASK_BUNDLE_ROOT=/absolute/shared/openreward-ppt-bundles
# ORS_PPT_ARTIFACT_ROOT=/absolute/shared/openreward-ppt-artifacts
# ORS_SLIDEFORGE_REWARD_WORK_ROOT=/absolute/shared/openreward-ppt-reward-work
# ORS_PPT_RUNTIME_TOKEN=
# ORS_PPT_RUBRIC_TOKEN=
# MDRW_LLM_ENDPOINT=
# MDRW_LLM_API_KEY=
# MDRW_LLM_MODEL=

# Direct workspace-be / EntryPoint diagnosis only.
# AGENTOS_ENV=evaluation
# AGENTOS_WORKSPACE_BASE_URL=
# AGENTOS_ENTRYPOINT_BASE_URL=
# AGENTOS_WORKSPACE_JWT_KEY=
## On-demand octo-workflow skill; Results only extracts existing workflow links.
# Automatic workflow observer/analysis workers have been retired.
ROPS_SESSION_WORKFLOWS_ENABLED=false
ROPS_SESSION_WORKFLOW_ANALYSIS_ENABLED=false
ROPS_OCTO_BASE_URL=http://127.0.0.1:8300
ROPS_OCTO_API_KEY=
## Optional independent Company OneAPI identity (never replaces API/Personal defaults)
ROPS_ONEAPI_BASE_URL=https://models.example.com/v1
ROPS_ONEAPI_API_KEY=
ROPS_ONEAPI_MODEL=DeepSeek-V4.1-Flash
ROPS_ONEAPI_REASONING_EFFORT=high
